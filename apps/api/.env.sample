# ---- App ----
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Public origin of the WEB app — every mailed link (invite, reminder, password
# reset) is built from it. The API refuses to boot in production while this is a
# loopback address: a wrong value sends unusable links to every invitee and
# nothing server-side ever errors.
WEB_APP_URL=http://localhost:5173

# ---- Database (Postgres) ----
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=code
DATABASE_SSL=false
DATABASE_LOGGING=false
# Overrides the discrete vars above if set:
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/codestack

# ---- Redis (BullMQ + cache + throttler + socket adapter) ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ---- Auth / JWT (httpOnly cookies) ----
# Both are validated at boot with Joi `.min(32)`, so a short value is a hard
# startup failure, not a warning. The previous placeholders here were 16 and 17
# characters, which meant `cp .env.sample .env` produced an API that refused to
# start. Replace these with real secrets: `openssl rand -base64 48`.
JWT_ACCESS_SECRET=change-me-access-0000000000000000000000000000
JWT_REFRESH_SECRET=change-me-refresh-000000000000000000000000000
JWT_ACCESS_TTL=1d
JWT_REFRESH_TTL=7d
AUTH_COOKIE_DOMAIN=localhost
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax

# ---- Piston (code execution sandbox) ----
# Comma-separated list of full execute endpoints for the replica pool
PISTON_URLS=http://localhost:2000/api/v2/execute
PISTON_MAX_INFLIGHT=16
PISTON_CONNECT_TIMEOUT_MS=2000

# ---- Language runtimes / limits ----
PYTHON_VERSION=3.11.0
CPP_VERSION=10.2.0
JAVA_VERSION=15.0.2
JS_VERSION=20.11.1
DEFAULT_RUN_TIMEOUT_MS=3000
DEFAULT_RUN_MEMORY_LIMIT=256000000
DEFAULT_MAX_PROCESS_COUNT=64
DEFAULT_OUTPUT_MAX_BYTES=65536

# ---- Judge queue ----
JUDGE_WORKER_CONCURRENCY=8
JUDGE_QUEUE_RATE_MAX=100
JUDGE_QUEUE_RATE_DURATION_MS=1000

# ---- Rate limiting (per-user) ----
THROTTLE_RUN_PER_MIN=5
THROTTLE_RUN_PER_DAY=50
THROTTLE_SUBMIT_PER_MIN=1
THROTTLE_SUBMIT_PER_DAY=50
THROTTLE_GLOBAL_PER_DAY=1000

# ---- Transactional mail ----
# OFF by default. With EMAIL_ENABLED=false the mailer logs the rendered text body
# (including invite links) instead of sending — and only outside production, so a
# deployment that forgets this never writes tokens to its log.
# A disabled mailer needs NO credentials of any kind: no provider is constructed at
# all, so RESEND_API_KEY may stay empty even with EMAIL_PROVIDER=resend.
EMAIL_ENABLED=false

# Which provider delivers: `smtp` (default), `resend`, or `brevo`.
#   smtp   — nodemailer to EMAIL_HOST. The local default (mailpit, no credentials,
#            no egress). Also the SMTP path to Brevo — see the Brevo block below —
#            but Railway's free tier firewalls outbound 587/465 regardless of
#            credentials, so this fails with ETIMEDOUT there.
#   resend — Resend's HTTP API (https://api.resend.com/emails). Implemented and
#            available; not currently in use.
#   brevo  — Brevo's HTTP API (https://api.brevo.com/v3/smtp/email), same account
#            and sender as the SMTP block below, over HTTPS instead of raw SMTP.
#            Use this one on a host that blocks outbound mail ports — it's a
#            normal port-443 POST, so the block never applies to it.
# NOTE — "Resend" here means the email PROVIDER (resend.com). It is unrelated to
# re-sending an invite (`POST /invites/:id/resend`), which is a different feature
# that happens to share the word.
EMAIL_PROVIDER=smtp

# --- smtp provider: local development (mailpit) ---
# Defaults point at the `mailpit` service in docker-compose: a local SMTP sink
# with a web UI on http://localhost:8025, no auth, no TLS, no outbound mail.
# `docker compose up -d mailpit`, set EMAIL_ENABLED=true, and every message lands
# there. Point this at a real relay only when you mean to send real mail.
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_USER=
EMAIL_PASSWORD=
# STARTTLS on a non-465 port. Leave false for mailpit; true for any real relay,
# where it is what stops a silent plaintext downgrade on port 587.
EMAIL_USE_TLS=false

# --- smtp provider: production (Brevo over SMTP) ---
# Works against Brevo's relay wherever outbound 587/465 isn't firewalled. It needs
# NO provider-specific code — it is ordinary authenticated SMTP, so
# `EMAIL_PROVIDER=smtp` and these four values are the whole configuration. On
# Railway's free tier this connection times out regardless of credentials — use
# the `brevo` provider block below instead on a host that blocks mail ports.
#
#   EMAIL_HOST=smtp-relay.brevo.com
#   EMAIL_PORT=587            # STARTTLS. Use 465 for implicit TLS; the transport
#                             # derives `secure` from the PORT, never from the flag.
#   EMAIL_USE_TLS=true        # sets nodemailer `requireTLS` — fails the send rather
#                             # than silently downgrading to plaintext.
#   EMAIL_USER=<login>@smtp-brevo.com
#   EMAIL_PASSWORD=<the xsmtpsib-… SMTP key>   # SECRET. Not an account password.
#
# DEFAULT_FROM_EMAIL must be a VALIDATED SENDER in Brevo or the relay rejects the
# message. The `"Name <addr>"` display form is accepted.
#
# DELIVERABILITY, worth knowing before wondering why mail lands in spam: a from-address
# on a domain you do not control (a gmail.com address, say) cannot be DKIM-aligned for
# that domain, so it will authenticate as Brevo rather than as the sender. It delivers,
# but a domain you own with Brevo's DKIM records published is what gets it into inboxes
# reliably — and it is the same change that would let a Resend switch work.

# --- brevo provider: Brevo's HTTP API instead of SMTP ---
# Same Brevo account, sender and deliverability as the SMTP block above — only the
# transport changes. A POST to api.brevo.com:443 isn't SMTP traffic, so it isn't
# subject to a host's mail-port firewall (this is what unblocks Railway's free
# tier). Set EMAIL_PROVIDER=brevo and DEFAULT_FROM_EMAIL as above; EMAIL_HOST,
# EMAIL_USER and EMAIL_PASSWORD are ignored by this provider.
#
# SECRET. Required only when EMAIL_ENABLED=true AND EMAIL_PROVIDER=brevo. This is
# Brevo's API key (starts `xkeysib-…`), NOT the SMTP key above — the two are
# different credentials in the same Brevo account. Same containment as
# RESEND_API_KEY below: never logged, `pnpm check:invariants` pins the files
# allowed to read it.
BREVO_API_KEY=
# EMAIL_RATE_MAX has no default for this provider either, for the same reason as
# Resend's below — check Brevo's account send limit and set at most half of it.

# --- resend provider ---
# SECRET. Required only when EMAIL_ENABLED=true AND EMAIL_PROVIDER=resend.
# Use a SENDING-ONLY key, never a full-access one: a full-access key can create and
# revoke domains and other keys, which delivery never needs. The key must not appear
# in any log — the transport builds every message from the response alone and scrubs
# anything key-shaped out of provider text, and `pnpm check:invariants` pins the set
# of files allowed to read it.
RESEND_API_KEY=
# Fallback if the HTTP API ever has to be abandoned: Resend also speaks SMTP, which
# needs no code change — EMAIL_PROVIDER=smtp, EMAIL_HOST=smtp.resend.com,
# EMAIL_PORT=465, EMAIL_USER=resend, EMAIL_PASSWORD=<the api key>.

# The sender. MUST be on a domain VERIFIED in Resend, or every send answers 403.
# Verification means adding Resend's DNS records to a zone you control — so a
# platform-provided host (a *.up.railway.app subdomain, say) can never be verified.
# `onboarding@resend.dev` needs no verification but delivers ONLY to the Resend
# account owner's own address: useful as a one-off smoke test, useless for invites.
DEFAULT_FROM_EMAIL=no-reply@codestack.dev

# Worker-side delivery shape. The BullMQ limiter is Redis-global, so this is the
# cap across every worker pod, not per pod — and any other Resend API traffic shares
# the same account budget.
EMAIL_WORKER_CONCURRENCY=4
# 20/s is fine for mailpit and for a real SMTP relay, and is FAR above a typical
# Resend account limit — which is why it is REQUIRED (no default) when
# EMAIL_PROVIDER=resend: inheriting it silently is what produces a 429 storm on the
# first bulk roster import. Resend's real POST /emails limit is not the one its read
# endpoints report, so it cannot be looked up here: the transport logs the observed
# limit once on the first successful send, and this should be at most half of it.
EMAIL_RATE_MAX=20
EMAIL_RATE_DURATION_MS=1000
# Demo-request notifications — predates the mailer and still has no consumer.
DEMO_NOTIFICATION_EMAILS=

# ---- AI module (Phase 2) ----
LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_MODEL=claude-opus-4-8
LLM_MAX_INPUT_TOKENS=12000
LLM_MAX_OUTPUT_TOKENS=8000
LLM_TIMEOUT_MS=120000
LLM_MAX_COST_USD_PER_REQUEST=1.0
AI_FREE_GENERATIONS_PER_MONTH=2
AI_MAX_FILE_BYTES=10485760
AI_RATE_LIMIT_PER_HOUR=5

# ---- Billing (Phase 3) ----
PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
BILLING_SUCCESS_URL=http://localhost:5173/billing/success
BILLING_CANCEL_URL=http://localhost:5173/billing/cancel

# ---- Platform / SuperAdmin bootstrap ----
# Comma-separated emails promoted to SUPERADMIN (org-less) by `seed:superadmin`.
CODESTACK_SUPERADMIN_EMAILS=
# Optional: gives a NEW SuperAdmin a password. Without one the seeded row has no
# password hash and cannot sign in at all until a password reset.
CODESTACK_SUPERADMIN_PASSWORD=
